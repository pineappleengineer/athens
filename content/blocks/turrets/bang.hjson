type: ItemTurret
localizedName: Bang
description: "Fires low tier cartridges, does decent amount of damage to enemy units. Has low ammo capacity, recommened to build a ammo box."
details: inspired by that gun animation called 'whizzbang' or osmething

range: 170
rotateSpeed: 2
ammoTypes: {
    solid-gallium-cartridge: {
        type: BasicBulletType
        backRegion: cartridge-small-back
        frontRegion: cartridge-small
        status: lobotomy
        speed: 20.0
        velocityScaleRandMin: 0.9
        velocityScaleRandMax: 1
        trailLength: 5.0
        trailWidth: 1.5
        shootEffect: shootScepterSecondary
        smokeEffect: shootBigSmoke2
        height: 16.0
        width: 8.0
        shrinkY: 0.0
        lifetime: 10.0
        damage: 23.75
        pierce: true
        pierceDamageFactor: 1
        backColor: c3b7ffff
        frontColor: e7e3ffff
        hitColor: c3b7ffff
        trailColor: c3b7ffff
        hitEffect: colorSpark
        despawnEffect: colorSpark
    }
}
drawer: {
    type: DrawTurret
    basePrefix: armoured-
    top: bang-top
    preview: bang-preview
    parts: [
        {
            type: RegionPart
            suffix: -top
            replaceOutline: true
            layerOffset: 0.001
        }
        {
            type: RegionPart
            suffix: -cartridge
            replaceOutline: true
            moves: [
                {
                    type: PartMove
                    progress: reload
                    x: 3.0
                }
            ]
        }
        {
            type: RegionPart
            suffix: -hammer
            progress: reload
            replaceOutline: true
            moveY: 0.5
        }
    ]
}
size: 2.0
buildVisibility: shown
outlineColor: 111317ff
reload: 36.0
shootSound: shootBreachCarbide
inaccuracy: 0.2
maxAmmo: 10.0
shake: 0.1
recoil: 0.5
shootY: -0.5